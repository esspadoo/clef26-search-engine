package unipd.se.model;

/**
 * Represents a query enriched with additional information generated during
 * the query expansion phase.
 * <p>
 * This class extends {@link QueryDoc} by storing the original query text,
 * extracted keywords, and the expanded query text used for retrieval.
 * </p>
 *
 * @author RETRIX
 * @version 1.0
 * @since 1.0
 */
public class ExpandedQueryDocTEX extends QueryDoc {

    /**
     * Original text of the query before expansion.
     */
    public String original;

    /**
     * Keywords extracted from the original query.
     */
    public String keywords;

    /**
     * Expanded version of the query used to improve retrieval.
     */
    public String expanded;

    /**
     * Compatibility for TEX queries.
     */
    public String expansion;

    /**
     * Returns the original, non-expanded query text.
     *
     * @return the original query text
     */
    public String getOriginal() {
        return original;
    }

    /**
     * Returns the expanded query text.
     *
     * @return the expanded query text
     */
    public String getExpanded() {
        return expanded;
    }

    /**
     * Returns only the expansion terms, without the original query text.
     * <p>
     * Resolution order:
     * </p>
     * <ol>
     *   <li>If {@code expansion} is set and non-blank (old format), return it
     *       directly.</li>
     *   <li>If {@code expanded} starts with {@code original} (new format),
     *       strip the prefix and return the remainder.</li>
     *   <li>Otherwise return an empty string.</li>
     * </ol>
     *
     * @return the expansion-only terms, never {@code null}
     */
    public String getExpansionOnly() {
        // Old format: expansion field holds only the extra terms
        if (expansion != null && !expansion.isBlank()) {
            return expansion;
        }
        // New format: strip the original prefix from the concatenated expanded field
        if (expanded != null && !expanded.isBlank()
                && original != null && !original.isBlank()
                && expanded.startsWith(original)) {
            return expanded.substring(original.length()).trim();
        }
        return "";
    }


    /**
     * Returns the text that must be used by the search engine.
     * <p>
     * Falls back in order:
     * </p>
     * <ol>
     *   <li>{@code expanded} — full text preferred for single-query use</li>
     *   <li>{@code original} — original query if no expansion available</li>
     *   <li>{@code text}     — base field inherited from {@link QueryDoc}</li>
     * </ol>
     *
     * @return the best available search text, never {@code null}
     */
    @Override
    public String getSearchText() {
        if (expanded != null && !expanded.isBlank()) return expanded;
        if (expansion != null && !expansion.isBlank()) return expansion;

        return expanded;
    }
}